# ==========================================
# 🔑 SILELO Neo-Connect — Environment Variables
# 📌 วิธีใช้: ก๊อปไฟล์นี้เป็น .env (สำหรับ dev ในเครื่อง)
#    หรือตั้งค่าผ่าน Dashboard: Vercel → Settings → Environment Variables
#    (production ไม่ได้อ่านไฟล์ .env — อ่านจาก Dashboard เสมอ)
# ⚠️ ห้าม commit ไฟล์ .env จริงเด็ดขาด! .gitignore ครอบไว้แล้ว
# ==========================================

# 🧠 AI Providers — GPT/Groq หลัก ตามด้วย OpenRouter fallback
OPENAI_API_KEY=                  # ถ้ามี จะลอง GPT ก่อน (server-only)
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=                    # ถ้า GPT ไม่พร้อม จะลอง Groq
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3.6-27b,openai/gpt-oss-20b,groq/compound-mini,llama-3.1-8b-instant
GEMINI_API_KEYS=                 # หลายคีย์คั่นด้วย , (9 keys)
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_API_KEY=              # fallback หลัง GPT/Groq (server-only)
OPENROUTER_TEXT_MODELS=z-ai/glm-5.2:free,liquid/lfm-2.5-2.6b:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free,poolside/laguna-xs-2.1:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,dots-studio/dots-3-note-preview:free,minimax/minimax-m2.7:free,minimax/minimax-m3:free,google/gemma-4-26b-a4b-it:free,poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free,thinkingmachines/inkling:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_FAST_TIMEOUT_MS=8000  # server mode: provider throughput sort
POLLINATIONS_MODEL=openai        # คง fallback เดิม (ฟรี ไม่ต้อง key)

# 🧠 OpenAI TTS (optional)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# 🤖 Azure OpenAI / Copilot (สำรอง)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4o

# 🎨 สร้างภาพ (สำรอง)
DALL_API_KEY=
STABILITY_API_KEY=

# 🎙️ เสียง — Azure Speech (สำรอง) / ElevenLabs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=thailand
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=
TTS_VOICE=th-TH-PremwadeeNeural

# 🌐 LINE — บอท + LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# 🐙 GitHub Repository Integration — token ใช้เฉพาะฝั่ง server ห้ามส่งไป browser
GITHUB_TOKEN=
GITHUB_OWNER=phanuphanthcanthrsngsaeng17-del
GITHUB_REPO=silelo-neo-connect

# 🔌 Real connector gateway — ห้ามเปิดเผย token ใน browser
# API key สำหรับให้ gateway เรียก Manus API v2 และ connector ที่ผู้ใช้ authorize แล้ว
MANUS_API_KEY=
# Gateway ต้องรองรับ POST /v1/integrations/:service/:action และ GET /v1/status
CONNECTOR_GATEWAY_URL=
CONNECTOR_GATEWAY_TOKEN=
CONNECTOR_GATEWAY_TIMEOUT_MS=15000

# 🔐 ความปลอดภัย — Login
# สร้าง hash ด้วย: node scripts/hash-password.js "รหัสผ่านที่แข็งแรง"
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD_HASH=
# สุ่มค่าอย่างน้อย 32 bytes และห้ามใช้ค่าเริ่มต้นใน production
AUTH_SECRET=
AUTH_WHITELIST=
RUN_SECRET=
JWT_SECRET=

# 🔗 OAuth Login (Google / Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FB_APP_ID=
FB_APP_SECRET=

# 📦 ฐานข้อมูล (สำรอง)
DATABASE_URL=

# ⚙️ ระบบ
APP_URL=https://silelo-neo-connect.onrender.com
SILELO_URL=https://silelo.onrender.com
NODE_ENV=production
PORT=3000
LANG=th-TH
TIMEZONE=Asia/Bangkok
