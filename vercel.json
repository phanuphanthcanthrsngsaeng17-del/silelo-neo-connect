{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/chat",
      "dest": "/public/chat.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "model/bossnusilelo.onnx",
        "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs",
        "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
        "node_modules/onnxruntime-web/dist/ort.node.min.mjs",
        "node_modules/onnxruntime-web/dist/ort.min.mjs",
        "node_modules/onnxruntime-web/dist/ort.wasm.min.mjs"
      ]
    }
  }
}
