    <!-- ===== Custom Permission ===== -->
    <permission
        android:name="com.bossnusilelo.kingdom.permission.PRIVACY_BROADCAST"
        android:protectionLevel="signature" />

    <application
        android:label="BOSSNUSILELO KINGDOM"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service สำหรับ Foreground Service (camera/mic/location) -->
        <service
            android:name=".ForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location|mediaPlayback" />

        <!-- Receiver สำหรับ notification badge -->
        <receiver
            android:name=".BadgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Receiver สำหรับ SMS -->
        <receiver
            android:name=".SMSReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

